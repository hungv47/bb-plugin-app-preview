{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "server.ts",
    "app.tsx",
    "contract.ts",
    "detect.ts",
    "ready.ts",
    "paths.ts",
    "snapshot.ts",
    "store.ts",
    "service.ts",
    "rpc-input.ts",
    "components",
    "lib",
    "hooks",
    "*.test.ts"
  ]
}
